{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": [
      "DOM",
      "ES2022"
    ],
    "rootDirs": [
      "src",
      "../example/src"
    ],
    "paths": {
      "three": [
        "./vendor/three/three-untyped.d.ts"
      ]
    },
    "noImplicitAny": false
  },
  "include": [
    "src",
    "test",
    "../example/src"
  ]
}
